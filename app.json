{
  "expo": {
    "name": "Hallowed Hop Society",
    "slug": "hhs-native",
    "version": "1.0.149",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#191726"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "149",
      "bundleIdentifier": "com.zplotindustries.hallowedhopsociety",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "venmo"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Hallowed Hop Society uses the camera so you can add photos to Wall posts.",
        "NSPhotoLibraryUsageDescription": "Hallowed Hop Society uses your photo library so you can attach photos and videos to Wall posts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#191726"
      },
      "package": "com.zplotindustries.hallowedhopsociety",
      "versionCode": 149,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hallowedhopsociety.com"
            },
            {
              "scheme": "https",
              "host": "www.hallowedhopsociety.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./android/app/google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "hhsNativeBeerScreen": "1",
      "eas": {
        "projectId": "7c415298-5d23-4f3d-b818-60a6ba5475a2"
      }
    },
    "owner": "z-plot-industries",
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-image-picker"
    ],
    "scheme": "hhs",
    "description": "Hallowed Hop Society — 31 unique beers in 31 haunted days.",
    "primaryColor": "#191726"
  }
}