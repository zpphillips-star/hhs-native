{
  "expo": {
    "name": "Hallowed Hop Society",
    "slug": "hhs-native",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#191726"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zplotindustries.hallowedhopsociety",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "venmo"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#191726"
      },
      "package": "com.zplotindustries.hallowedhopsociety",
      "versionCode": 14,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hallowedhopsociety.com"
            },
            {
              "scheme": "https",
              "host": "www.hallowedhopsociety.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7c415298-5d23-4f3d-b818-60a6ba5475a2"
      }
    },
    "owner": "z-plot-industries",
    "plugins": [
      "expo-notifications"
    ],
    "scheme": "hhs",
    "description": "Hallowed Hop Society — 31 unique beers in 31 haunted days.",
    "primaryColor": "#191726"
  }
}
